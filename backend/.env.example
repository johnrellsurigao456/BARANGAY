# Copy this file to .env before running the app.

PORT=3000

# Used to sign session cookies. Change this to a long random string before any real deployment.
SESSION_SECRET=change-this-to-a-long-random-string

# Default administrator account created by `npm run seed`.
# Change this password immediately after first login.
DEFAULT_ADMIN_EMAIL=admin@barangayecocare.gov.ph
DEFAULT_ADMIN_PASSWORD=ChangeMe!2026
